function [cost, trivial] = DDP_erods_renyi(k, beta)
    disp("p = " + p)
    fract_targ = 0.1;
    fract_dist = 0.1;
    n = 100;
    params = num2cell([n, p]);
    [costs, ~, trivials] = run_test( ...
        @erdos_renyi, ...
        params, ...
        "sample_size", 24, ...
        "fraction_targets", fract_targ, ...
        "fraction_disturbances", fract_dist, ...
        "ddp", "state_feedback" ...
        );
    cost = 1 - mean(costs);
    trivial = 1 - mean(trivials);
    disp("cost = " + cost + ", triv. = " + trivial)
end


function [cost, trivial] = DDP_watts_strogatz(k, beta)
    disp("k = " + k)
    disp("beta = " + beta)
    fract_targ = 0.1;
    fract_dist = 0.1;
    n = 100;
    params = num2cell([n, k, beta]);
    [costs, ~, trivials] = run_test( ...
        @watts_strogatz, ...
        params, ...
        "sample_size", 100, ...
        "fraction_targets", fract_targ, ...
        "fraction_disturbances", fract_dist, ...
        "ddp", "state_feedback" ...
        );
    cost = 1-mean(costs);
    trivial = 1-mean(trivials);
    disp("cost = " + cost + ", triv. = " + trivial)
end

function [cost, trivial] = DDP_sfg(alpha, beta, gamma)
    % disp("alpha = " + alpha + ", beta = " + beta + ", gamma = " + gamma)
    fract_targ = 0.1;
    fract_dist = 0.1;
    n = 100;
    params = num2cell([n, alpha, beta, gamma, 1, 1]);
    [costs, ~, trivials] = run_test( ...
        @sfg, ...
        params, ...
        "sample_size", 100, ...
        "fraction_targets", fract_targ, ...
        "fraction_disturbances", fract_dist, ...
        "ddp", "state_feedback" ...
        );
    cost = 1 - mean(costs);
    trivial = 1 - mean(trivials);
    % disp("cost = " + cost + ", triv. = " + trivial)
end
